FROM debian:bookworm-slim AS tdlib
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake g++ git gperf libssl-dev make php-cli zlib1g-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . /src/td
RUN cmake -S /src/td -B /build -DCMAKE_BUILD_TYPE=Release -DTD_ENABLE_JNI=OFF && cmake --build /build --target tdjson -j4

FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TDLIB_LIBRARY_PATH=/usr/local/lib/libtdjson.so \
    TDLIB_DATABASE_DIRECTORY=/data/tdlib/db \
    TDLIB_FILES_DIRECTORY=/data/tdlib/files
WORKDIR /app
COPY open-tgate/requirements.txt .
RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir -r requirements.txt
COPY open-tgate/app ./app
COPY open-tgate/docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
COPY --from=tdlib /build/libtdjson.so /usr/local/lib/libtdjson.so
RUN chmod +x /usr/local/bin/worker-entrypoint && mkdir -p /data/tdlib/db /data/tdlib/files && chown -R 65532:65532 /data /app
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
CMD ["python", "-m", "app.worker"]
