# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Telegram / TDLib (server-side worker only)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TDLIB_LIBRARY_PATH=/usr/local/lib/libtdjson.so
TDLIB_DATABASE_DIRECTORY=/data/tdlib/db
TDLIB_FILES_DIRECTORY=/data/tdlib/files

# Supabase (server-side values must never be exposed to the dashboard)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Dashboard / API
API_BASE_URL=http://localhost:8000
DASHBOARD_ORIGIN=http://localhost:3000
API_ADMIN_TOKEN=
PORT=8000
WORKER_ID=open-tgate-worker-1
HEARTBEAT_INTERVAL_SECONDS=30

# Telegram account runtime (multi-account login + read-only auto-sync).
# The account manager only activates when TELEGRAM_API_ID/HASH + SUPABASE_* are
# set; otherwise the worker runs heartbeats only.
COMMAND_POLL_SECONDS=3
SYNC_PACING_SECONDS=0.4
MAX_LOGIN_ACCOUNTS=25

# Observability (Sentry). Leave SENTRY_DSN empty to disable reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# AI processing belongs to a downstream worker, not the Telegram sync process
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Optional downstream integrations
NOTION_TOKEN=
NOTION_PRIVATE_OPERATIONS_PAGE_ID=

# Safety defaults
EXTERNAL_SEND_ENABLED=false
